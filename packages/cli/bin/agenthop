#!/bin/bash
set -euo pipefail
source="${BASH_SOURCE[0]}"
while [ -L "$source" ]; do
  dir="$(cd "$(dirname "$source")" && pwd)"
  link="$(readlink "$source")"
  if [[ "$link" != /* ]]; then
    source="$dir/$link"
  else
    source="$link"
  fi
done
bin_dir="$(cd "$(dirname "$source")" && pwd)"
root="$(cd "$bin_dir/../../.." && pwd)"
tsx="$bin_dir/../node_modules/.bin/tsx"
if [ ! -x "$tsx" ]; then
  tsx="$root/node_modules/.bin/tsx"
fi
if [ ! -x "$tsx" ]; then
  echo "agenthop: run pnpm install in $root first" >&2
  exit 1
fi
exec "$tsx" "$root/packages/cli/src/bin.ts" "$@"
